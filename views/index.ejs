<!DOCTYPE html>
<html lang="es">
<%- include('partials/head') %>
<body>
  <%- include('partials/navbar') %>

  <main class="container">
    <!-- Bienvenida -->
    <section class="text-center mb-5">
      <h1 class="display-5 fw-bold">BIENVENIDO A <span class="marca">TRAILERFLIX</span></h1>
      <p class="lead">¿Miramos algo? Tenemos <%= total %> títulos:
        <%= peliculas %> películas y <%= series %> series.</p>
    </section>

    <!-- Tabla de endpoints disponibles -->
    <section class="mb-5">
      <h2 class="h4 mb-3">Endpoints disponibles</h2>
      <div class="table-responsive">
        <table class="table table-bordered align-middle">
          <thead>
            <tr><th>Ruta</th><th>Descripción</th><th>Ejemplo</th></tr>
          </thead>
          <tbody>
            <tr>
              <td><code>/catalogo</code></td>
              <td>Lista todo el catálogo</td>
              <td><a href="/catalogo">/catalogo</a></td>
            </tr>
            <tr>
              <td><code>/titulo/:title</code></td>
              <td>Busca por título (parcial)</td>
              <td><a href="/titulo/crown">/titulo/crown</a></td>
            </tr>
            <tr>
              <td><code>/categoria/:cat</code></td>
              <td>Filtra por serie o película</td>
              <td><a href="/categoria/serie">/categoria/serie</a> · <a href="/categoria/pelicula">/categoria/pelicula</a></td>
            </tr>
            <tr>
              <td><code>/reparto/:act</code></td>
              <td>Busca por actriz o actor (parcial)</td>
              <td><a href="/reparto/pascal">/reparto/pascal</a></td>
            </tr>
            <tr>
              <td><code>/trailer/:id</code></td>
              <td>Devuelve id, título y URL del trailer</td>
              <td><a href="/trailer/1">/trailer/1</a> · <a href="/trailer/5">/trailer/5</a> (sin trailer)</td>
            </tr>
            <tr>
              <td><code>GET /contenido</code> · <code>GET /contenido/:id</code></td>
              <td>Listado y detalle por id</td>
              <td><a href="/contenido">/contenido</a> · <a href="/contenido/1">/contenido/1</a></td>
            </tr>
            <tr>
              <td><code>POST /contenido</code> · <code>PUT /contenido/:id</code> · <code>DELETE /contenido/:id</code></td>
              <td>Alta, modificación y baja de contenido (JSON)</td>
              <td>Ver README</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Catálogo generado dinámicamente desde la base de datos MySQL -->
    <section>
      <h2 class="h4 mb-3">Catálogo</h2>
      <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        <% for (let i = 0; i < catalogo.length; i++) { %>
          <% const item = catalogo[i]; %>
          <div class="col">
            <div class="card h-100">
              <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <h3 class="h5 card-title mb-0"><%= item.titulo %></h3>
                  <span class="badge <%= item.categoria === 'Serie' ? 'bg-primary' : 'bg-warning text-dark' %>">
                    <%= item.categoria %>
                  </span>
                </div>
                <p class="small text-secondary mb-2">#<%= item.id %> · <%= item.genero %></p>
                <p class="card-text small flex-grow-1"><%= item.sinopsis %></p>
                <p class="small text-secondary mb-3"><strong>Reparto:</strong> <%= item.reparto %></p>
                <% if (item?.trailer) { %>
                  <a class="btn btn-danger btn-sm" href="<%= item.trailer %>" target="_blank" rel="noopener">▶ Ver trailer</a>
                <% } else { %>
                  <button class="btn btn-secondary btn-sm" disabled>Trailer no disponible</button>
                <% } %>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
