<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= titulo %></title>
  <!-- Bootstrap desde CDN -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <style>
    body { background-color: #141414; color: #e5e5e5; }
    .marca { color: #e50914; font-weight: 800; letter-spacing: 1px; }
    .card { background-color: #1f1f1f; border: 1px solid #2a2a2a; color: #e5e5e5; }
    .card .text-secondary { color: #a3a3a3 !important; }
    .table { --bs-table-bg: #1f1f1f; --bs-table-color: #e5e5e5; --bs-table-border-color: #333; }
    code { color: #ff6b6b; }
    a.btn-danger { background-color: #e50914; border-color: #e50914; }
  </style>
</head>
